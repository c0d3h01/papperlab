# PaperLab production template.
# Copy to .env on the server and fill in the real values:
#   cp .env.production .env
#   openssl rand -hex 32   # use this for PAPERLAB_API_KEY
# Never commit the filled .env. It is ignored by git.

# --- Server ---
PAPERLAB_ADDR=:8080
# 0 when Cloudflare Pages serves the front end. Use 1 for an all-in-one container.
PAPERLAB_SERVE_WEB=0
PAPERLAB_WEB_DIR=web
PAPERLAB_DATA_DIR=/data

# --- Limits ---
# Cloudflare caps proxied request bodies at 100 MB on common plans.
PAPERLAB_MAX_UPLOAD_MB=100
PAPERLAB_MAX_FILES=30
PAPERLAB_JOB_TTL_MIN=120
PAPERLAB_JOB_TIMEOUT_MIN=20
PAPERLAB_RATE_LIMIT_PER_MIN=120

# --- Access ---
# Set a long random value to require X-API-Key or Bearer authentication.
# Then store it in the browser as localStorage.paperlab_api_key.
PAPERLAB_API_KEY=
# Exact Pages/custom-domain origin, comma-separated if there are several.
PAPERLAB_CORS_ORIGINS=https://paperlab.example
# Keep false unless HTML-to-PDF must reach private network addresses.
PAPERLAB_ALLOW_LOCAL_URLS=false

# --- Engines ---
# Leave empty to auto-detect. The container already sets the usual paths.
PAPERLAB_CHROME_PATH=
PAPERLAB_LIBREOFFICE_PATH=

# --- AI (optional) ---
# Leave the base URL empty to use local summarization and retrieval.
# Example: https://api.openai.com/v1
PAPERLAB_AI_BASE_URL=
PAPERLAB_AI_API_KEY=
PAPERLAB_AI_MODEL=gpt-4o-mini

# --- Translation (optional) ---
PAPERLAB_LIBRETRANSLATE_URL=
