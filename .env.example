# PaperLab local development environment.
# Copy to .env, then export it before running the Go binary:
#   cp .env.example .env
#   set -a; . ./.env; set +a
# Docker Compose reads .env automatically.

# --- Server ---
PAPERLAB_ADDR=:8080
PAPERLAB_SERVE_WEB=1
PAPERLAB_WEB_DIR=web
PAPERLAB_DATA_DIR=./data

# --- Limits ---
PAPERLAB_MAX_UPLOAD_MB=250
PAPERLAB_MAX_FILES=30
PAPERLAB_JOB_TTL_MIN=120
PAPERLAB_JOB_TIMEOUT_MIN=20
PAPERLAB_RATE_LIMIT_PER_MIN=240

# --- Access ---
# Leave empty to disable API-key authentication.
PAPERLAB_API_KEY=
# Comma-separated front-end origins. Narrow this when the UI is served from another origin.
PAPERLAB_CORS_ORIGINS=*
# IPs or CIDRs of a reverse proxy/tunnel that sets X-Forwarded-For.
# Leave empty when the API is directly exposed.
PAPERLAB_TRUSTED_PROXIES=
# Allow HTML-to-PDF to fetch localhost or private network URLs.
PAPERLAB_ALLOW_LOCAL_URLS=false

# --- Engines ---
# Leave empty to auto-detect from PATH.
PAPERLAB_CHROME_PATH=
PAPERLAB_LIBREOFFICE_PATH=

# --- AI (optional) ---
# OpenAI-compatible base URL. Leave empty for local summarization/retrieval.
PAPERLAB_AI_BASE_URL=
PAPERLAB_AI_API_KEY=
PAPERLAB_AI_MODEL=gpt-4o-mini

# --- Translation (optional) ---
PAPERLAB_LIBRETRANSLATE_URL=
